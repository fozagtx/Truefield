{
  "$id": "Diagnosis", "type": "object",
  "required": ["event_id","status","likely_cause","confidence","evidence","citations","recommended_actions","uncertainties"],
  "properties": {
    "event_id": {"type": "string"},
    "status": {"enum": ["diagnosed","needs_human","insufficient_evidence"]},
    "likely_cause": {"type": "string", "maxLength": 200},
    "component": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "agrees_with_rules": {"type": "boolean"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["doc","locator","quote"],
      "properties": {"doc": {"type": "string"}, "locator": {"type": "string"}, "quote": {"type": "string", "maxLength": 300}}}},
    "recommended_actions": {"type": "array", "items": {"type": "string"}},
    "parts": {"type": "array", "items": {"type": "object", "properties": {"part_no": {"type": "string"}, "desc": {"type": "string"}, "qty": {"type": "integer"}}}},
    "est_repair_minutes": {"type": ["integer", "null"]},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "suggested_severity": {"enum": ["watch","warning","alarm","critical"]},
    "suggested_risk_level": {"enum": ["low","medium","high"]}
  }
}

# Copy to .env (git-ignored). MODEL_ACCESS_KEY is required: the API refuses to start without it. Never commit real values.
# Everything else has a code default (see truefield/config.py) and can still be overridden by env.

# Primary LLM: OpenAI-compatible inference API
MODEL_ACCESS_KEY=
MODEL_BASE_URL=https://inference.do-ai.run/v1
MODEL_NAME=gpt-4o

# Evolus (optional; blank = Evolus steps skipped and shown as "not configured"). Agent model id and extractor owner are derived from APP_ID + AGENT_ID.
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_AGENT_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_LIBRARY_ID=

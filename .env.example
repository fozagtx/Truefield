# Copy to .env (git-ignored). Leave blank to run in mock mode. Never commit real values.
# ---------- AMD / vLLM (Gemma 4 on MI300X) ----------
VLLM_BASE_URL=http://<DROPLET_IP>:8000/v1
VLLM_API_KEY=
VLLM_MODEL=google/gemma-4-26B-A4B-it
HF_TOKEN=
# ---------- Evolus (event workspace) ----------
EVOLUS_API_KEY=
EVOLUS_APP_ID=            # space ID from the API keys page (X-Application-Id)
EVOLUS_AGENT_ID=
EVOLUS_AGENT_MODEL=       # "<applicationId>:<agentId>" from GET /v1/models
EVOLUS_LIBRARY_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_EXTRACTOR_AGENT_ID=
EVOLUS_REST_BASE=https://api.evolus.ai/api/v1
EVOLUS_CHAT_BASE=https://api.evolus.ai/v1
EVOLUS_MINUTES_TOOL=minutes
# ---------- App ----------
LLM_PROVIDER=auto         # auto | evolus | vllm | mock
PUBLIC_BASE_URL=          # public URL of the API, for the workflow callbackUrl (else polling)
TRUEFIELD_CALLBACK_KEY=      # checked on /callback/evolus (X-Truefield-Key)
DEMO_CACHE=0              # 1 = replay recorded LLM responses (labelled "cached")
DEMO_CACHE_RECORD=0       # 1 = record LLM responses into DATA_DIR/demo_cache
COST_PER_HOUR_USD=36000   # Siemens 2024 FMCG figure
PLANNED_REPAIR_MINUTES=90
UNPLANNED_BASELINE_MINUTES=480
DATA_DIR=./data
MODEL_PATH=./models/ae-v1.pt
TRUEFIELD_DATASET=auto       # auto | demo | raw | synthetic
AUTO_PIPELINE=1           # 1 = event -> diagnosis -> work order automatically
MOCK_GUARDRAIL_DEMO=1     # mock model tries to lower severity so the guardrail is visible
HTTP_TIMEOUT_S=30
